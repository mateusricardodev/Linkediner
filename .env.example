# Copie para .env e ajuste. Nunca faça commit do .env.
NODE_ENV=development
LOG_LEVEL=info

# Se a 5432 estiver ocupada, defina POSTGRES_PORT (usada pelo infra/compose.yaml) e ajuste a porta abaixo.
# POSTGRES_PORT=5433
DATABASE_URL=postgres://linkediner:linkediner@localhost:5432/linkediner

API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# Autenticação. Gere um valor próprio com: openssl rand -base64 48
AUTH_SECRET=troque-este-valor-local-por-um-segredo-aleatorio-de-48-bytes
# Provedores OAuth: cada provedor só é ativado com ID e segredo definidos.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Storage compatível com S3 (SeaweedFS local, ver infra/compose.yaml)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=linkediner-documents
STORAGE_ACCESS_KEY_ID=linkediner
STORAGE_SECRET_ACCESS_KEY=linkediner-dev

# IA: "fake" por padrão. Gemini gratuito só com dados sintéticos (ADR 0004).
AI_PROVIDER=fake
AI_TIER=free
# GEMINI_API_KEY=
# AI_MODEL_EXTRACT=

# Obrigatória em staging/produção (mínimo 32 caracteres)
# LOG_PSEUDONYM_SECRET=

WORKER_CONCURRENCY=4
OTEL_ENABLED=false
